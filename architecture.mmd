flowchart TB
    developer["Developer runs Terraform"] --> terraform["Terraform root configuration\nvariables.tf, providers.tf, main.tf"]
    terraform --> module["Reusable ecs-app module"]

    subgraph aws["AWS Region: selected value, for example us-east-1"]
        subgraph network["VPC 10.0.0.0/16"]
            igw["Internet Gateway"]
            subgraph public["Public subnets in 2 Availability Zones"]
                alb["Application Load Balancer\nHTTP :80"]
                nat["NAT Gateway\nElastic IP"]
            end
            subgraph private["Private subnets in 2 Availability Zones"]
                ecs1["ECS Fargate task\nprivate IP :3000"]
                ecs2["ECS Fargate task\nprivate IP :3000"]
            end
            routes["Route tables\npublic -> IGW\nprivate -> NAT"]
            albsg["ALB security group\nallow HTTP from internet"]
            ecssg["ECS security group\nallow app port from ALB only"]
        end
        target["ALB target group\ntarget type: IP\nhealth check: /"]
        listener["ALB listener\nHTTP :80 -> target group"]
        cluster["ECS cluster"]
        service["ECS service\ndesired task count"]
        taskdef["Task definition\nawsvpc, CPU, memory, env vars"]
        logs["CloudWatch log group"]
        role["ECS task execution IAM role"]
    end

    registry["Existing Docker registry\nimage configured by docker_image"]
    internet["Internet user"] --> alb
    alb --> listener --> target
    target --> ecs1
    target --> ecs2
    service --> ecs1
    service --> ecs2
    cluster --> service
    taskdef --> service
    role --> taskdef
    ecs1 --> logs
    ecs2 --> logs
    registry --> ecs1
    registry --> ecs2
    ecs1 --> nat --> igw
    ecs2 --> nat
    albsg -. protects .-> alb
    ecssg -. protects .-> ecs1
    ecssg -. protects .-> ecs2
    routes -. routes traffic .-> alb
    routes -. routes traffic .-> ecs1
    routes -. routes traffic .-> ecs2
    module --> network
    module --> cluster
    module --> taskdef
    module --> service
    module --> logs
    module --> role

    classDef control fill:#e8f1ff,stroke:#315a9b,color:#10213d
    classDef network fill:#eaf7ef,stroke:#2d7a4b,color:#12351f
    classDef security fill:#fff3d6,stroke:#a66b00,color:#4a3000
    classDef external fill:#f4eafa,stroke:#754c91,color:#2d173d
    class developer,terraform,module,cluster,service,taskdef,role,logs control
    class network,public,private,igw,alb,nat,target,listener network
    class albsg,ecssg security
    class registry,internet external